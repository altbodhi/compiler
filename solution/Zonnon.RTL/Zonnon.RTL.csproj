<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Zonnon.RTL</AssemblyName>
    <RootNamespace>Zonnon.RTL</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>InterimKey.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>$(DefineConstants);ROTOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="Attributes.cs;obj\**;bin\**" />
    <Compile Include="..\Compiler\zcversion.cs" Link="zcversion.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ETH.Zonnon</AssemblyName>
    <RootNamespace>Compiler</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>InterimKey.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>$(DefineConstants);ROTOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="Test.cs;Test1.cs;Tests.cs;Table.cs;SysInfo.cs;SC.cs;Registration.cs;List.cs;Compute\ExpressionVisitor.cs;obj\**;bin\**" />
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <Reference Include="System.Compiler">
      <HintPath>..\CCI\Mono\System.Compiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Compiler.Framework">
      <HintPath>..\CCI\Mono\System.Compiler.Framework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Compiler.Runtime">
      <HintPath>..\CCI\Mono\System.Compiler.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\Zonnon.RTL\Zonnon.RTL.csproj" />
    <EmbeddedResource Remove="**/*.resx;**/*.ResX" />
    <EmbeddedResource Include="Compute\ComputeKernelTemplates.resx">
      <LogicalName>Compiler.Compute.ComputeKernelTemplates.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ErrorMessages.ResX">
      <LogicalName>Compiler.ErrorMessages.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
